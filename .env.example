# Copy this file to .env before running Docker Compose.
AIOPS_FRONTEND_PORT=5174
AIOPS_BACKEND_PORT=8080
AIOPS_PYTHON_PORT=8001
AIOPS_MYSQL_PORT=3307
AIOPS_REDIS_PORT=6379

AIOPS_MYSQL_DATABASE=aiops
AIOPS_MYSQL_PASSWORD=change-me-local-mysql-password
AIOPS_REDIS_PASSWORD=
AIOPS_JWT_SECRET=change-me-local-jwt-secret-at-least-32-characters
# Docker-only: parent directory for local Olist imports, for example D:/data
AIOPS_LOCAL_IMPORT_HOST_PATH=

AI_PROVIDER=deepseek
AI_BASE_URL=https://api.deepseek.com
AI_CHAT_PATH=/v1/chat/completions
AI_API_KEY=replace-with-your-ai-provider-api-key
AI_MODEL=deepseek-v4-flash
AI_TIMEOUT=60
AI_NEGATIVE_REPLY_ENGINE=langchain
AI_NEGATIVE_REPLY_THINKING_ENABLED=false
AI_NEGATIVE_REPLY_MAX_TOKENS=320
AI_MAX_RETRIES=2
COMMENT_AI_SHADOW_DEFAULT_SAMPLE_SIZE=60
COMMENT_AI_SHADOW_MAX_SAMPLE_SIZE=100
COMMENT_AI_SHADOW_DEFAULT_MAX_TOTAL_TOKENS=60000
COMMENT_AI_SHADOW_MAX_TOTAL_TOKENS=100000
COMMENT_AI_MODE=rule
COMMENT_AI_HYBRID_MIN_CONFIDENCE=0.80
COMMENT_AI_HYBRID_MIN_ANNOTATED=50
COMMENT_AI_HYBRID_MIN_ANNOTATION_COVERAGE=0.80
COMMENT_AI_HYBRID_MIN_CALL_SUCCESS_RATE=0.95
COMMENT_AI_HYBRID_MIN_JSON_VALID_RATE=0.98
COMMENT_AI_HYBRID_MIN_EVIDENCE_VALID_RATE=0.98
COMMENT_AI_HYBRID_MAX_SENTIMENT_ACCURACY_DROP=0.02
COMMENT_AI_HYBRID_MIN_PROBLEM_MICRO_F1_GAIN=0.05

# Optional local RAG runtime. It stays inactive until an operator enables it.
RAG_ENABLED=false
RAG_COLLECTION=aiops_knowledge_v1
RAG_TOP_K=4
RAG_MIN_RELEVANCE_SCORE=0.35
RAG_MAX_CONTEXT_CHARS=6000
RAG_REPLY_TOP_K=2
RAG_REPLY_MAX_CONTEXT_CHARS=1800
RAG_REVIEW_EVIDENCE_MAX_DOCUMENTS=2000
RAG_CHROMA_DIR=./data/chroma
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_DEVICE=cpu

CRAWLER_ENABLED=false

ALIYUN_OSS_ENDPOINT=https://oss-cn-beijing.aliyuncs.com
ALIYUN_OSS_BUCKET_NAME=replace-with-your-bucket-name
ALIYUN_OSS_ACCESS_KEY_ID=replace-with-your-access-key-id
ALIYUN_OSS_ACCESS_KEY_SECRET=replace-with-your-access-key-secret
