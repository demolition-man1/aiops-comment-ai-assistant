# Copy this file to .env before running Docker Compose.
AIOPS_FRONTEND_PORT=5174
AIOPS_BACKEND_PORT=8080
AIOPS_PYTHON_PORT=8001
AIOPS_MYSQL_PORT=3306
AIOPS_REDIS_PORT=6379

AIOPS_MYSQL_DATABASE=aiops
AIOPS_MYSQL_PASSWORD=replace-with-a-strong-mysql-password
AIOPS_REDIS_PASSWORD=
AIOPS_JWT_SECRET=replace-with-a-random-jwt-secret-at-least-32-characters

AI_PROVIDER=deepseek
AI_BASE_URL=https://api.deepseek.com
AI_CHAT_PATH=/v1/chat/completions
AI_API_KEY=replace-with-your-ai-provider-api-key
AI_MODEL=deepseek-chat
AI_TIMEOUT=60
CRAWLER_ENABLED=false

ALIYUN_OSS_ENDPOINT=https://oss-cn-beijing.aliyuncs.com
ALIYUN_OSS_BUCKET_NAME=replace-with-your-bucket-name
ALIYUN_OSS_ACCESS_KEY_ID=replace-with-your-access-key-id
ALIYUN_OSS_ACCESS_KEY_SECRET=replace-with-your-access-key-secret
